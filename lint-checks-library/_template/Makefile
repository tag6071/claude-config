.PHONY: help verify lint test audit-docs ai-brief

help:                           ## show this list
	@awk 'BEGIN{FS=":.*## "} /^[a-z][a-zA-Z0-9_-]*:.*## / { printf "  %-14s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

verify: lint test               ## run all gates (lint + tests; add audit-docs if present)

lint:                           ## hard-block sloppy patterns (scripts/lint-anti-patterns.sh)
	@bash scripts/lint-anti-patterns.sh

